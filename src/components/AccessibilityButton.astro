<!-- Bouton pour ouvrir modal -->
<button class="a11y-btn" aria-label="Paramètres d’accessibilité">⚙️</button>

<!-- Modal paramètres -->
<div id="a11y-panel" class="a11y-panel" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
  <h2>Accessibilité</h2>

  <p>Taille du texte :</p>
  <div class="a11y-section">
    <button id="a11y-font-small" data-font="small">A-</button>
    <button id="a11y-font-medium" data-font="medium">A</button>
    <button id="a11y-font-large" data-font="large">A+</button>
  </div>

  <p>Menu mobile :</p>
  <div class="a11y-section">
    <button id="a11y-side-left" data-menu="left">Gauche</button>
    <button id="a11y-side-center" data-menu="center">Centre</button>
    <button id="a11y-side-right" data-menu="right">Droite</button>
  </div>

  <button class="a11y-close">Fermer</button>
</div>

<div id="a11y-toast" role="status" aria-live="polite">
  💡 Vous pouvez ajuster la taille du texte et la position du menu avec le bouton ⚙️
</div>

<script>
(() => {
  const btn = document.querySelector('.a11y-btn');
  const panel = document.getElementById('a11y-panel');
  const close = panel.querySelector('.a11y-close');
  const menu = document.querySelector('.navbar__menu');

  if (!btn || !panel || !menu) return;

  /* ===== Modal ===== */
  const open = () => panel.setAttribute('aria-hidden','false');
  const hide = () => panel.setAttribute('aria-hidden','true');

  btn.addEventListener('click', open);
  close.addEventListener('click', hide);

  document.addEventListener('keydown', e => { if(e.key==='Escape') hide(); });
  document.addEventListener('click', e => {
    if(panel.getAttribute('aria-hidden')==='false' && !panel.contains(e.target) && e.target!==btn) hide();
  });

  /* ===== Taille du texte ===== */
  const fontButtons = panel.querySelectorAll('[data-font]');
  fontButtons.forEach(b => b.addEventListener('click', () => {
    document.documentElement.dataset.fontSize = b.dataset.font;
    localStorage.setItem('fontSize', b.dataset.font);
  }));

  const savedFont = localStorage.getItem('fontSize');
  if(savedFont) document.documentElement.dataset.fontSize = savedFont;

  /* ===== Position menu mobile ===== */
  const menuButtons = panel.querySelectorAll('[data-menu]');
  const applyMenuSide = () => {
    menu.classList.remove('left','right'); // toujours nettoyer
    if(window.innerWidth <= 768) {       // seulement sur mobile
      const side = document.documentElement.dataset.menuSide || 'center';
      menu.classList.add(side);
    }
  };

  menuButtons.forEach(b => b.addEventListener('click', () => {
    document.documentElement.dataset.menuSide = b.dataset.menu;
    localStorage.setItem('menuSide', b.dataset.menu);
    applyMenuSide();
  }));

  const savedSide = localStorage.getItem('menuSide');
  if(savedSide) document.documentElement.dataset.menuSide = savedSide;

  /* Appliquer au chargement et au resize */
  applyMenuSide();
  window.addEventListener('resize', applyMenuSide);
})();

// Notif 
(() => {
  const toast = document.getElementById('a11y-toast');

  // Affiche seulement si jamais vu
  if(!localStorage.getItem('a11yToastShown')) {
    toast.classList.add('show');

    // Masque après 5 secondes
    // setTimeout(() => toast.classList.remove('show'), 5000);

    // onclick
    toast.addEventListener("click", ()=>{toast.classList.remove('show')});

    // Enregistre que l'utilisateur a vu le toast
    localStorage.setItem('a11yToastShown', 'true');
  }
})();
    
</script>

