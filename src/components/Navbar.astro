}

/* ===== MOBILE ===== */
@media (max-width: 768px) {
  // ajout pour param
  /* Par défaut navbar à gauche */
  html[data-menu-side="left"] .navbar {
    left: 1rem;
    right: auto;
  }

  /* Navbar à droite */
  html[data-menu-side="right"] .navbar {
    left: auto;
    right: 1rem;
    .navbar__menu {
      translate: -10em;
    }
  }

  .navbar__toggle {
    display: block;
  }

  .navbar__menu {
    position: absolute;
    top: 3.5rem;
