---
const {website, name, logo, desc} = Astro.props;
---

<a href={website} target="_blank" title={desc}>
    <img class="partnerLogo" id={name} src=`/partner/${logo}` alt={'logo '+ name}>
</a>

<style>
    img.partnerLogo {
        background: none;
        box-shadow: none;
        border-radius: 0;
        max-width: 20rem;
        padding: 1rem;
    }
</style>