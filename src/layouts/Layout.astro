---
import JSONLD from "../components/JSON-LD.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { AstroFont } from "astro-font";

const { description } = Astro.props
const { origin, pathname } = Astro.url;
const canonical = origin + pathname;

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.svg">
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description}>
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:title" content={`Sport & Mobilité`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`https://sport-mobilite.fr`} />
		<meta property="og:image" content="/accessibilite.png" />
		<title>Sport & Mobilité</title>
		<AstroFont 
			config={[
			{
			name: "sintony",
			src: [
				{
				style: 'normal',
				weight: '',
				path: '/font/Sintony-Regular.ttf'
				},
			],
			preload: true,
			display: "swap",
			fallback: "sans-serif",
			},
			{
			name: "akatabReg",
			src: [
				{
				weight: '',
				style: 'normal',
				path: '/font/Akatab-Regular.ttf'
				}
			],
			preload: true,
			display: "swap",
			fallback: "serif",
			},
		]}/>
		<JSONLD/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style lang="scss" is:global >
	:root {
		--shadow-1: 0 0 13px 0px #00000033;
		--blur-1: blur(20px);
		--modal-backgroud: rgba(240, 248, 255, 0.579);
	}

	// @font-face {
	// 	font-family: 'sintony';
	// 	src: url('/font/Sintony-Regular.ttf') format('truetype');
	// }
	// @font-face {
	// 	font-family: 'akatabReg';
	// 	src: url('/font/Akatab-Regular.ttf') format('truetype');
	// }

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}

	// h1 {
	// font-size: 2.5rem; /* avant c'était 40px, par exemple */
	// }

	// h2 {
	// font-size: 2rem;
	// }

	// h3 {
	// font-size: 1.5rem;
	// }

	h1,
	h2,
	h3,
	h4 {
		font-family: "sintony";
		text-transform: uppercase;
	}

	p {
		font-family: "akatabReg";
	}

	a {
		color: rgb(82, 123, 255);
	}

	section {
		h2{
			text-decoration: underline;
		}
		min-height: 70vh;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background-color: white;
		margin-bottom: 2em;

		.container {
			display: flex;
			width: 90vw;
			justify-content: space-evenly;
			align-items: center;

			&_imgs {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				justify-content: space-evenly;
			}

			img {
				border-radius: 20px;
				box-shadow: var(--shadow-1);
				height: fit-content;
				background-color: aliceblue;
			}
			p,
			img {
				max-width: 30vw;
			}
			p {
				font-size: 1.2rem;
			}
		}
	}

	@media screen and (max-width: 850px) {
		section {
			.container {
				flex-direction: column;
				
				p,
				img {
					max-width: 90vw;
				}
			}
		}
	}

</style>
