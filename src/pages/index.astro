				/>
				<Partner
					name="Commelesautres"
					website="https://www.commelesautres.org/antenne/bretagne"
					logo="CLA_BZH.jpg"
					desc="Une approche originale de l'accompagnement social"
				/>
				<Partner
					name="Merlib"
					website="/"
					logo="merlib.png"
					desc="Le libre accès à la mer pour les handicapés"
				/>
				<Partner
					name="Handisub"
					website="https://www.csce-stmalo.fr/category/commissions/comission-handi/"
					logo="handisub.jpg"
					desc="Le monde sous-marin accessible aux personnes en situation de handicap"
				/>
				
			</div>
		</section>
