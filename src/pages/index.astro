<style lang="scss">
	.partner {
		flex-wrap: wrap;
	}

	.section__partner {
		h2 {
			text-align: center;
		}
	}
	#programme {
		p {
			font-size: 1.2rem;
		}
		.container_plans p, .programme_p {
			text-align: center;
			max-width: 80vw;
		}
	}
	.container_plans,
	.container_tombola {
		display: flex;
		width: 100vw;
		margin-top: 5em;
		margin-bottom: 5em;
		flex-direction: column;
		align-items: center;
		&__imgs {
			display: flex;
			justify-content: space-evenly;
			width: 100%;

			img {
				border-radius: 20px;
				box-shadow: var(--shadow-1);
				height: fit-content;
				max-height: 20em;
				margin: 1em;
			}
		}
	}

	.container_tombola {
		z-index: 0;
		background-color: rgba(240, 248, 255, 0.579);
	}
	.container_tombola__imgs {
		display: flex;
		justify-content: space-evenly;
		align-items: center;
		width: 100%;
		img {
			border-radius: 20px;
			box-shadow: none;
			height: fit-content;
			max-height: 20em;
			margin: 1em;
		}
		p {
			text-align: left;
			max-width: 40vw;
		}
	}

	.tombola-parallax {
		will-change: transform;
		transition: transform 0.1s linear;
	}

	@media screen and (max-width: 850px) {
		.container_plans,
		.container_tombola {
			&__imgs {
				display: flex;
				flex-direction: column;
				align-items: center;

				img {
					max-width: 90%;
				}
			}
		}
		.container_tombola__imgs {
			display: flex;
			justify-content: space-evenly;
			align-items: center;
			width: 100%;
			img {
				border-radius: 20px;
				box-shadow: none;
				height: fit-content;
				max-height: 20em;
				margin: 1em;
			}
			p {
				text-align: left;
				max-width: 80vw;
			}
		}

		#secondPrice {
			flex-direction: column-reverse;
		}
	}
</style>
<script>
	window.addEventListener("DOMContentLoaded", () => {
		const images = document.querySelectorAll(".tombola-parallax");

		function updateParallax() {
			const scrollY = window.scrollY;
			const windowHeight = window.innerHeight;

			images.forEach((img) => {
				const rect = img.getBoundingClientRect();
				const elementTop = rect.top + scrollY;

				// distance par rapport au centre écran
				const distance = scrollY + windowHeight / 2 - elementTop;

				// vitesse du parallax
				const speed = 0.05;

				img.style.transform = `translateY(${distance * speed}px)`;
			});
		}

		window.addEventListener("scroll", () => {
			requestAnimationFrame(updateParallax);
		});

		updateParallax();
	});
</script>