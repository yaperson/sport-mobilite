---
import Layout from "../layouts/Layout.astro";
import ConferenceLanding from "../components/ConferenceLanding.astro";
---

<Layout
  description=`Reservez une place pour une conférence ou un essai  - première édition le 23 Avril 2026`
>
  <main>
      <h1>Réservations</h1>

    <section id="conference">
      <ConferenceLanding 
        title="Conférence"
        text={`Ne manquez pas la conférence de <strong>Géraud Paillot</strong>, fondateur de l’association 
            <a href="https://www.facebook.com/AventureHustive/?locale=fr_FR" target="_blank">Aventure HUSTIVE</a> sur la résilience et la gestion du mental, lors de 
            la journée <strong>Sport & Mobilité</strong> le 
            <time datetime="2026-04-23">23 avril 2026</time>, organisée par <a href="https://hopicile.fr" target="_blank">Hopicile</a>.`} 
        image="/ConfHopicile.jpg" 
        altImage="Affiche de la conférence Résilience et gestion du mental par Géraud Paillot" 
        revervationLink="https://docs.google.com/forms/d/e/1FAIpQLSeCql9qfxa2UxQqOQYYCHm1CVvMV0ETXQAgjEZs44FJpV6KdA/viewform?usp=header" 
      />
      <ConferenceLanding 
        title="Présentation Handisub"
        text={`Découvrez l’association <strong>Handisub</strong>, qui rend la plongée sous-marine accessible aux personnes en situation de handicap, et assistez à la projection d’une courte vidéo présentant l'association !`}
        image="/partner/handisub.jpg" 
        altImage="Logo de l'association Handisub" 
      />
    </section>

    <section>
      <h2>Essais</h2>
      <p>
        Les créneaux pour participer aux essais seront disponibles très bientôt.
        Vous pourrez réserver votre place directement sur cette page.
      </p>
      <p>
        📅 Date : 23 avril 2026<br />
        📍 Lieu : Hopicile, Dinan
      </p>
    </section>

      <!-- <form class="notify-form">
      <label>
        Votre email pour être informé dès l'ouverture des réservations :
        <input type="email" placeholder="exemple@mail.com" required />
      </label>
      <button type="submit">Me prévenir</button>
    </form> -->
  </main>
</Layout>

<style lang="scss">
  main {
    display: flex;
    flex-direction: column;
    align-items: center;

    section {
      width: 90vw;
      img {
        max-width: 30vw;
      }
    }
  }
</style>
